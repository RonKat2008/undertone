{
  "expo": {
    "name": "Undertone",
    "slug": "undertone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR code shown on the Undertone dashboard."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR code shown on the Undertone dashboard."
        }
      ],
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#120F0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "scheme": "undertone",
    "backgroundColor": "#120F0C"
  }
}
